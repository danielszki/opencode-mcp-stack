# Copie para ~/.config/opencode/.env (ou exporte no shell) e preencha.
# Nunca commite o .env real.

FIRECRAWL_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# BCE (bgts-context-engine)
BCE_DB_HOST=127.0.0.1
BCE_DB_PORT=5432
BCE_DB_NAME=bce
BCE_DB_USER=bce
BCE_DB_PASSWORD=bce
BCE_GRAPH_NAME=code_graph
BCE_ENV_FILE=$HOME/opencode/bgts-context-engine/.env

# omnivoice / VoiceStudio
OMNIVOICE_API_URL=http://127.0.0.1:3900
OMNIVOICE_TORCH_VARIANT=cpu
HF_HOME=$HOME/.cache/huggingface
